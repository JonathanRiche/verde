# Copy to .env for local use. Values below are intentionally incomplete.
VERDE_ENV=test
VERDE_LISTEN_HOST=0.0.0.0
VERDE_PORT=8787
VERDE_PUBLIC_BASE_URL=http://localhost:8787
VERDE_CONTROL_PLANE_ISSUER=http://localhost:8787
DATABASE_URL=postgres://verde:change-me@localhost:55432/verde_connect

# Test authentication cannot be enabled outside VERDE_ENV=test. Use at least 32 random bytes.
VERDE_AUTH_MODE=test
VERDE_TEST_AUTH_TOKEN=
VERDE_TEST_PRINCIPAL_ISSUER=https://test-idp.invalid
VERDE_TEST_PRINCIPAL_SUBJECT=local-operator

# Exact native public-client values published for authorization-code + PKCE S256.
VERDE_OAUTH_PUBLIC_CLIENT_ID=verde-connect-local
VERDE_OAUTH_SCOPES=openid,profile
VERDE_OAUTH_REDIRECT_URIS=http://127.0.0.1:48123/callback

# Production OIDC mode also requires VERDE_OIDC_ISSUER, VERDE_OIDC_AUDIENCE,
# and an exact VERDE_OIDC_JWKS_URI pin to constrain metadata-driven egress.
# Access tokens must be signed JWTs with typ=at+jwt, exact issuer/audience, iat,
# exp, and no more than VERDE_OIDC_MAX_TOKEN_AGE_SECONDS lifetime (default 900).

# Generate this owner-only file with: bun run keygen > .local/grant-signing.jwk
VERDE_GRANT_SIGNING_JWK_FILE=.local/grant-signing.jwk
# During rotation, point this at the documented public retired-key bundle.
VERDE_GRANT_PREVIOUS_JWKS_FILE=

# "external" accepts an operator-managed normalized HTTPS/WSS descriptor.
# "noop" exists only for hermetic tests and is rejected outside VERDE_ENV=test.
VERDE_ENDPOINT_ADAPTER=external

# Optional operator audit export token. Use at least 32 random bytes.
VERDE_OPERATOR_TOKEN=

# Comma-separated exact proxy socket IPs. Leave empty for direct-only service.
VERDE_TRUSTED_PROXY_IPS=
