FROM debian:bookworm-slim

ARG VERDE_UID=10001
ARG VERDE_GID=10001

RUN apt-get update \
    && apt-get install --yes --no-install-recommends \
        bash \
        ca-certificates \
        git \
        nodejs \
        openssh-client \
        tini \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --gid "${VERDE_GID}" verde \
    && useradd --create-home --home-dir /home/verde --uid "${VERDE_UID}" --gid "${VERDE_GID}" --shell /bin/bash verde

COPY --chown=verde:verde zig-out/container-rootfs/opt/verde /opt/verde
COPY --chmod=0755 packages/daemon/container/entrypoint.sh /usr/local/bin/verde-container-entrypoint
COPY LICENSE /usr/share/licenses/verde/LICENSE

ENV HOME=/home/verde \
    PATH=/opt/verde/bin:/home/verde/.local/bin:/usr/local/bin:/usr/bin:/bin \
    VERDE_DATA_DIR=/home/verde/.local/share/verde/runtime \
    VERDE_WEB_TOKEN_FILE=/home/verde/.config/verde/web-token \
    VERDE_GATEWAY_PORT=7420 \
    VERDE_MODE=runtime

RUN install -d -o verde -g verde -m 0700 \
        /home/verde/.config/verde \
        /home/verde/.local/share/verde/runtime \
        /workspace

USER verde:verde
WORKDIR /workspace
STOPSIGNAL SIGTERM

HEALTHCHECK --interval=15s --timeout=5s --start-period=15s --retries=4 \
    CMD /opt/verde/bin/verde-daemon status --data-dir "$VERDE_DATA_DIR" --json

ENTRYPOINT ["/usr/bin/tini", "-g", "--", "/usr/local/bin/verde-container-entrypoint"]
