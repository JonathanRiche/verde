{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://verde.dev/specs/control-plane/v1/schemas/connector-credential-jwe.schema.json",
  "title": "Protected header for a connector credential JWE",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "alg",
    "enc",
    "typ",
    "kid",
    "enrollment_id",
    "expires_at",
    "epk"
  ],
  "properties": {
    "alg": { "const": "ECDH-ES" },
    "enc": { "const": "A256GCM" },
    "typ": { "const": "verde-connect-credential+jwe" },
    "kid": { "type": "string", "pattern": "^[A-Za-z0-9_-]{16,128}$" },
    "enrollment_id": { "$ref": "common.schema.json#/$defs/enrollmentId" },
    "expires_at": { "$ref": "common.schema.json#/$defs/timestamp" },
    "epk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kty", "crv", "x"],
      "properties": {
        "kty": { "const": "OKP" },
        "crv": { "const": "X25519" },
        "x": { "type": "string", "pattern": "^[A-Za-z0-9_-]{43}$" }
      }
    }
  }
}
