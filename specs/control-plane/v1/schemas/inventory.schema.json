{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://verde.dev/specs/control-plane/v1/schemas/inventory.schema.json",
  "title": "Runtime inventory messages",
  "$defs": {
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract_version", "request_id"],
      "properties": {
        "contract_version": {
          "$ref": "common.schema.json#/$defs/contractVersion"
        },
        "request_id": {
          "$ref": "common.schema.json#/$defs/requestId"
        },
        "runtime_ids": {
          "type": "array",
          "maxItems": 100,
          "uniqueItems": true,
          "items": {
            "$ref": "common.schema.json#/$defs/runtimeId"
          }
        }
      }
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["link_id", "status", "descriptor", "linked_at"],
      "properties": {
        "link_id": {
          "$ref": "common.schema.json#/$defs/linkId"
        },
        "status": {
          "const": "ready"
        },
        "descriptor": {
          "$ref": "runtime-descriptor.schema.json"
        },
        "linked_at": {
          "$ref": "common.schema.json#/$defs/timestamp"
        }
      }
    },
    "response": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract_version", "request_id", "runtimes"],
      "properties": {
        "contract_version": {
          "$ref": "common.schema.json#/$defs/contractVersion"
        },
        "request_id": {
          "$ref": "common.schema.json#/$defs/requestId"
        },
        "runtimes": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/item"
          }
        }
      }
    }
  }
}
