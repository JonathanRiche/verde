{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://verde.dev/specs/control-plane/v1/schemas/signer-discovery.schema.json",
  "title": "Verde Connect grant signer metadata",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "issuer", "jwks_uri", "algorithms"],
  "properties": {
    "contract_version": {
      "$ref": "common.schema.json#/$defs/contractVersion"
    },
    "issuer": {
      "type": "string",
      "format": "uri",
      "maxLength": 2048
    },
    "jwks_uri": {
      "$ref": "common.schema.json#/$defs/httpsUrl"
    },
    "algorithms": {
      "const": ["EdDSA"]
    },
    "maximum_grant_lifetime_seconds": {
      "type": "integer",
      "minimum": 15,
      "maximum": 300
    }
  }
}
